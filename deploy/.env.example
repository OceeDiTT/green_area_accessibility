# Copy to deploy/.env and edit.
# Domain name for automatic HTTPS (its DNS A-record must point at this server), or ":80" for plain HTTP (testing / private network).
SITE_ADDRESS=:80
# Origins allowed to call the API from a browser. "*" is fine for a public read-only API; otherwise e.g. https://greenspace.example.org
CORS_ORIGINS=*
# Set to false to stop serving the merged green-space polygons (/api/v1/layers/green) - see docs/DEPLOYMENT.md, section "Legal".
EXPOSE_GREEN_LAYER=true
# Memory cap for the pipeline container (not yet measured on real hardware - watch `docker stats` during the first load).
PIPELINE_MEM_LIMIT=4g
